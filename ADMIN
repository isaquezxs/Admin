-- Função para "sumir" o jogador localmente
local function VanishPlayer(target)
    if not target then return end

    local char = target.Character
    if char then
        char:Destroy()
    end

    -- Também oculta o nome na lista de players
    local coreGui = game:GetService("CoreGui")
    if coreGui:FindFirstChild("PlayerList") then
        -- apenas efeito visual
        pcall(function()
            local playerList = coreGui.PlayerList.PlayerListMaster.OffsetFrame.PlayerScrollList
            for _, item in pairs(playerList:GetDescendants()) do
                if item:IsA("TextLabel") and string.find(item.Text, target.Name) then
                    item.Text = "[Expulso]"
                end
            end
        end)
    end

    Notify("Jogador " .. target.Name .. " foi expulso (localmente).")
end

