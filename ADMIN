-- Shadow Hub: /kick, /jail (azul), /kill e /jumpscare (corrigido)
-- Autor: isaquexz

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

-- CONFIG
local ADMIN_NAMES = {"isaquexz"} -- nomes que podem usar comandos
local ENABLE_LOCAL_PLAYER_AS_ADMIN = true

local function Notify(text)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = "Shadow Hub",
			Text = text,
			Duration = 4
		})
	end)
end

local function IsAdmin(player)
	if not player then return false end
	if ENABLE_LOCAL_PLAYER_AS_ADMIN and player == LocalPlayer then return true end
	for _, name in ipairs(ADMIN_NAMES) do
		if player.Name:lower() == name:lower() or player.DisplayName:lower() == name:lower() then
			return true
		end
	end
	return false
end

local function FindPlayer(name)
	if not name then return nil end
	name = name:lower():gsub("^%s*(.-)%s*$","%1")
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Name:lower() == name or p.DisplayName:lower() == name then
			return p
		end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if string.find(p.Name:lower(), name, 1, true) or string.find(p.DisplayName:lower(), name, 1, true) then
			return p
		end
	end
	return nil
end

-----------------------------------------------------
-- KICK (local)
-----------------------------------------------------
local vanished, vanishConns = {}, {}

local function ApplyVanish(target)
	if not target or not target:IsA("Player") then return end
	if vanished[target.UserId] then return end
	vanished[target.UserId] = true

	if target.Character then pcall(function() target.Character:Destroy() end) end

	local conn = target.CharacterAdded:Connect(function(char)
		task.wait(0.05)
		if char and char.Parent then pcall(function() char:Destroy() end) end
	end)
	vanishConns[target.UserId] = conn
	Notify("🌀 " .. target.Name .. " foi kickado localmente.")
end

-----------------------------------------------------
-- JAIL (azul)
-----------------------------------------------------
local jailed = {}
local function CreateBlueJail(cframe)
	local model = Instance.new("Model")
	model.Name = "BlueJail"
	local size, half = 8, 4
	local color = Color3.fromRGB(0,120,255)
	local function part(sz, cf)
		local p = Instance.new("Part")
		p.Anchored = true
		p.Size = sz
		p.CanCollide = true
		p.Material = Enum.Material.Neon
		p.Color = color
		p.Transparency = 0.25
		p.CFrame = cf
		p.Parent = model
	end
	part(Vector3.new(size,1,size), cframe*CFrame.new(0,-half+0.5,0))
	part(Vector3.new(1,size,size), cframe*CFrame.new(half,0,0))
	part(Vector3.new(1,size,size), cframe*CFrame.new(-half,0,0))
	part(Vector3.new(size,size,1), cframe*CFrame.new(0,0,half))
	part(Vector3.new(size,size,1), cframe*CFrame.new(0,0,-half))
	model.Parent = Workspace
	model.PrimaryPart = model:FindFirstChildWhichIsA("Part")
	return model
end

local function ApplyJail(target, duration)
	duration = duration or 30
	if not target or not target.Character then return end
	local hrp = target.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local jail = CreateBlueJail(hrp.CFrame)
	jailed[target.UserId] = jail

	local humanoid = target.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then humanoid.WalkSpeed = 0 humanoid.JumpPower = 0 end
	task.spawn(function()
		for _=1,duration*4 do
			if not jailed[target.UserId] then break end
			if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
				target.Character.HumanoidRootPart.Anchored = true
			end
			task.wait(0.25)
		end
		if jailed[target.UserId] then
			pcall(function() jailed[target.UserId]:Destroy() end)
			jailed[target.UserId] = nil
			if humanoid then humanoid.WalkSpeed = 16 humanoid.JumpPower = 50 end
			Notify("🚪 " .. target.Name .. " foi solto.")
		end
	end)
	Notify("🔒 " .. target.Name .. " preso por " .. duration .. "s.")
end

-----------------------------------------------------
-- KILL (corrigido)
-----------------------------------------------------
local function KillPlayer(target)
	if not target or not target.Character then return end
	local hrp = target.Character:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp:Destroy() -- mata quebrando corpo
		Notify("💀 " .. target.Name .. " foi morto.")
	else
		local hum = target.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum.Health = 0 end
		Notify("💀 " .. target.Name .. " foi morto.")
	end
end

-----------------------------------------------------
-- JUMPSCARE (só aparece pra quem for o alvo)
-----------------------------------------------------
local function JumpscareLocal(target, dur)
	dur = dur or 3
	if target ~= LocalPlayer then return end

	local playerGui = LocalPlayer:WaitForChild("PlayerGui")
	local gui = Instance.new("ScreenGui", playerGui)
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.Name = "ShadowJumpscare"

	local img = Instance.new("ImageLabel", gui)
	img.Size = UDim2.new(1,0,1,0)
	img.BackgroundTransparency = 1
	img.Image = "rbxassetid://11371179636" -- 👹 imagem do jumpscare
	img.ImageTransparency = 1
	img.ScaleType = Enum.ScaleType.Crop

	local sound = Instance.new("Sound", gui)
	sound.SoundId = "rbxassetid://9124480469" -- 🔊 som de grito
	sound.Volume = 3
	sound:Play()

	local tweenIn = TweenService:Create(img, TweenInfo.new(0.2), {ImageTransparency = 0})
	tweenIn:Play()
	task.wait(dur)
	local tweenOut = TweenService:Create(img, TweenInfo.new(0.4), {ImageTransparency = 1})
	tweenOut:Play()
	task.wait(0.5)
	gui:Destroy()
end

-----------------------------------------------------
-- Processador de comandos
-----------------------------------------------------
local function ProcessCommand(from, msg)
	if not IsAdmin(from) then return end
	local cmd, arg = msg:match("^/(%w+)%s*(.*)$")
	if not cmd then return end
	cmd = cmd:lower()

	if cmd == "kick" then
		local t = FindPlayer(arg)
		if t then ApplyVanish(t) end
	elseif cmd == "jail" then
		local n, d = arg:match("^(%S+)%s*(%d*)$")
		local t = FindPlayer(n)
		if t then ApplyJail(t, tonumber(d) or 30) end
	elseif cmd == "kill" then
		local t = FindPlayer(arg)
		if t then KillPlayer(t) end
	elseif cmd == "jumpscare" then
		local n, d = arg:match("^(%S+)%s*(%d*)$")
		local t = FindPlayer(n)
		if t then JumpscareLocal(t, tonumber(d) or 3) end
	end
end

for _,p in ipairs(Players:GetPlayers()) do
	p.Chatted:Connect(function(m) pcall(function() ProcessCommand(p,m) end) end)
end
Players.PlayerAdded:Connect(function(p)
	p.Chatted:Connect(function(m) pcall(function() ProcessCommand(p,m) end) end)
end)
LocalPlayer.Chatted:Connect(function(m)
	pcall(function() ProcessCommand(LocalPlayer,m) end)
end)

Notify("✅ Shadow Hub pronto! Use /kick, /jail, /kill e /jumpscare")