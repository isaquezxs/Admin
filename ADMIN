-- Shadow Hub: /kick, /jail (azul) e /kill — sem UserId (usa nomes)
-- Autor: isaquexz (modificado)

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local StarterGui = game:GetService("StarterGui")

-- CONFIG: lista de nomes (Name ou DisplayName) que são admins
-- Exemplos: "isaquexz", "OutroNome"
local ADMIN_NAMES = {
    "isaquexz",
    -- "OutroAdmin",
}

-- Se true, o jogador que executar o script terá permissões automaticamente
local ENABLE_LOCAL_PLAYER_AS_ADMIN = true

local vanished = {}
local vanishConns = {}
local jailed = {}
local jailTimers = {}

local function Notify(text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "Shadow Hub",
            Text = text,
            Duration = 4
        })
    end)
end

local function isNameInList(name)
    if not name then return false end
    name = tostring(name):lower()
    for _, v in ipairs(ADMIN_NAMES) do
        if tostring(v):lower() == name then
            return true
        end
    end
    return false
end

local function IsAdmin(player)
    if not player then return false end
    -- permite LocalPlayer automaticamente se configurado
    if ENABLE_LOCAL_PLAYER_AS_ADMIN and player == LocalPlayer then
        return true
    end
    if isNameInList(player.Name) or (player.DisplayName and isNameInList(player.DisplayName)) then
        return true
    end
    return false
end

local function FindPlayer(name)
    if not name then return nil end
    name = name:lower():gsub("^%s*(.-)%s*$", "%1")
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Name:lower() == name or (p.DisplayName and p.DisplayName:lower() == name) then
            return p
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if string.find(p.Name:lower(), name, 1, true) or (p.DisplayName and string.find(p.DisplayName:lower(), name, 1, true)) then
            return p
        end
    end
    return nil
end

-- KICK (local)
local function ApplyVanish(target)
    if not target or not target:IsA("Player") then return end
    local uid = target.UserId
    if vanished[uid] then return end
    vanished[uid] = true

    if target.Character then
        pcall(function() target.Character:Destroy() end)
    end

    local conn
    conn = target.CharacterAdded:Connect(function(char)
        task.wait(0.05)
        if char and char.Parent then
            pcall(function() char:Destroy() end)
        end
    end)
    vanishConns[uid] = conn

    Notify(("[KICK] %s removido localmente"):format(target.Name))
end

local function RevokeVanish(target)
    if not target or not target:IsA("Player") then return end
    local uid = target.UserId
    if not vanished[uid] then return end
    vanished[uid] = nil
    if vanishConns[uid] then
        pcall(function() vanishConns[uid]:Disconnect() end)
        vanishConns[uid] = nil
    end
    Notify(("[UNVANISH] %s"):format(target.Name))
end

-- JAIL azul
local function CreateBlueJail(cframe)
    local model = Instance.new("Model")
    model.Name = "BlueJail_" .. tostring(math.random(1000,9999))

    local size = 8
    local half = size/2
    local wallColor = Color3.fromRGB(0, 120, 255)

    local function makePart(size, cf)
        local p = Instance.new("Part")
        p.Size = size
        p.Anchored = true
        p.CanCollide = true
        p.Material = Enum.Material.Neon
        p.Color = wallColor
        p.Transparency = 0.25
        p.CFrame = cf
        p.Parent = model
        return p
    end

    makePart(Vector3.new(size, 1, size), cframe * CFrame.new(0, -half + 0.5, 0))
    makePart(Vector3.new(1, size, size), cframe * CFrame.new( half, 0, 0))
    makePart(Vector3.new(1, size, size), cframe * CFrame.new(-half, 0, 0))
    makePart(Vector3.new(size, size, 1), cframe * CFrame.new(0, 0,  half))
    makePart(Vector3.new(size, size, 1), cframe * CFrame.new(0, 0, -half))

    model.Parent = Workspace
    model.PrimaryPart = model:FindFirstChildWhichIsA("Part")
    return model
end

local function ApplyJail(target, duration)
    duration = duration or 60
    if not target or not target.Character then
        Notify("Jail falhou.")
        return
    end

    local hrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local jail = CreateBlueJail(hrp.CFrame)
    jailed[target.UserId] = jail

    task.spawn(function()
        while jailed[target.UserId] and jailed[target.UserId].Parent and target.Character do
            local root = target.Character:FindFirstChild("HumanoidRootPart")
            if root and jailed[target.UserId].PrimaryPart then
                root.Anchored = true
                root.CFrame = jailed[target.UserId].PrimaryPart.CFrame
            end
            task.wait(0.25)
        end
    end)

    jailTimers[target.UserId] = task.delay(duration, function()
        if jailed[target.UserId] then
            pcall(function() jailed[target.UserId]:Destroy() end)
        end
        jailed[target.UserId] = nil
        local root = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if root then root.Anchored = false end
        Notify(("[UNJAIL] %s"):format(target.Name))
    end)

    Notify(("[JAIL %ss] %s"):format(duration, target.Name))
end

local function RevokeJail(target)
    if not target then return end
    local uid = target.UserId
    if jailed[uid] then
        pcall(function() jailed[uid]:Destroy() end)
        jailed[uid] = nil
    end
    Notify(("[UNJAIL] %s"):format(target.Name))
end

-- KILL (local)
local function KillPlayer(target)
    if not target or not target.Character then return end
    local humanoid = target.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.Health = 0
        Notify(("[KILL] %s foi eliminado."):format(target.Name))
    else
        Notify("Não foi possível matar " .. target.Name)
    end
end

-- Processa comandos (aplica localmente apenas se remetente for admin pelo nome)
local function ProcessCommand(fromPlayer, rawMsg)
    if not rawMsg then return end
    local s = tostring(rawMsg):gsub("^%s*(.-)%s*$","%1")
    local cmd, rest = s:match("^/(%S+)%s*(.*)$")
    if not cmd then return end
    cmd = cmd:lower()

    if not IsAdmin(fromPlayer) then return end

    if cmd == "kick" then
        local target = FindPlayer(rest)
        if target then ApplyVanish(target) end

    elseif cmd == "unjail" then
        local target = FindPlayer(rest)
        if target then RevokeJail(target) end

    elseif cmd == "jail" then
        local name, dur = rest:match('^(%S+)%s*(%d*)')
        local target = FindPlayer(name)
        local d = tonumber(dur) or 60
        if target then ApplyJail(target, d) end

    elseif cmd == "kill" then
        local target = FindPlayer(rest)
        if target then KillPlayer(target) end
    end
end

-- Conecta chats
for _, p in ipairs(Players:GetPlayers()) do
    p.Chatted:Connect(function(msg)
        pcall(function() ProcessCommand(p, msg) end)
    end)
end
Players.PlayerAdded:Connect(function(p)
    p.Chatted:Connect(function(msg)
        pcall(function() ProcessCommand(p, msg) end)
    end)
end)
LocalPlayer.Chatted:Connect(function(msg)
    -- Processa localmente também para conveniência (se você for admin)
    if IsAdmin(LocalPlayer) then
        pcall(function() ProcessCommand(LocalPlayer, msg) end)
    end
end)

