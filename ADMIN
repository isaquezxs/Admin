--[[ 🔥 Shadow Kick System para Brookhaven (local)
Comando no chat: /kick NomeDoJogador
O jogador "some" apenas visualmente para você
Autor: isaquexz
--]]

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local StarterGui = game:GetService("StarterGui")

-- Notificação simples
local function Notify(text)
    StarterGui:SetCore("SendNotification", {
        Title = "Shadow Hub | Kick System",
        Text = text,
        Duration = 4
    })
end

-- Função para encontrar jogador pelo nome
local function FindPlayer(name)
    name = name:lower()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower():match(name) or plr.DisplayName:lower():match(name) then
            return plr
        end
    end
end

-- Função para "sumir" o jogador localmente
local function VanishPlayer(target)
    if not target then return end

    local char = target.Character
    if char then
        char:Destroy()
    end

    -- Também oculta o nome na lista de players
    local coreGui = game:GetService("CoreGui")
    if coreGui:FindFirstChild("PlayerList") then
        -- apenas efeito visual
        pcall(function()
            local playerList = coreGui.PlayerList.PlayerListMaster.OffsetFrame.PlayerScrollList
            for _, item in pairs(playerList:GetDescendants()) do
                if item:IsA("TextLabel") and string.find(item.Text, target.Name) then
                    item.Text = "[Expulso]"
                end
            end
        end)
    end

    Notify("Jogador " .. target.Name .. " foi expulso (localmente).")
end

-- Ouve mensagens do chat
LocalPlayer.Chatted:Connect(function(msg)
    local cmd, targetName = msg:match("^/(%w+)%s+(.+)")
    if cmd and cmd:lower() == "kick" then
        local target = FindPlayer(targetName)
        if target then
            VanishPlayer(target)
        else
            Notify("Jogador não encontrado: " .. targetName)
        end
    end
end)

Notify("Sistema /kick carregado com sucesso! Use /kick NomeDoJogador")

--[[ 🔷 Shadow Jail System | Brookhaven (local)
Comando no chat: /jail NomeDoJogador
Cria uma jaula azul em volta do jogador (efeito visual local)
Autor: isaquexz
--]]

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local StarterGui = game:GetService("StarterGui")
local RunService = game:GetService("RunService")

-- Notificação simples
local function Notify(text)
    StarterGui:SetCore("SendNotification", {
        Title = "Shadow Hub | Jail System",
        Text = text,
        Duration = 4
    })
end

-- Função para encontrar jogador
local function FindPlayer(name)
    name = name:lower()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower():match(name) or plr.DisplayName:lower():match(name) then
            return plr
        end
    end
end

-- Cria a jaula azul em volta do jogador
local function CreateJail(target)
    if not target or not target.Character or not target.Character:FindFirstChild("HumanoidRootPart") then
        return
    end

    local root = target.Character.HumanoidRootPart
    local jailFolder = Instance.new("Folder", workspace)
    jailFolder.Name = "ShadowJail_" .. target.Name

    local size = 5 -- tamanho da jaula
    local height = 6
    local thickness = 0.3

    -- Cria paredes da jaula
    local function createPart(pos, size)
        local part = Instance.new("Part")
        part.Anchored = true
        part.CanCollide = true
        part.Color = Color3.fromRGB(0, 170, 255)
        part.Material = Enum.Material.ForceField
        part.Transparency = 0.2
        part.Size = size
        part.CFrame = CFrame.new(pos)
        part.Parent = jailFolder
    end

    local pos = root.Position
    -- paredes
    createPart(pos + Vector3.new(size / 2, height / 2, 0), Vector3.new(thickness, height, size))
    createPart(pos - Vector3.new(size / 2, -0, 0), Vector3.new(thickness, height, size))
    createPart(pos + Vector3.new(0, height / 2, size / 2), Vector3.new(size, height, thickness))
    createPart(pos - Vector3.new(0, -0, size / 2), Vector3.new(size, height, thickness))
    -- topo e base
    createPart(pos + Vector3.new(0, height, 0), Vector3.new(size, thickness, size))
    createPart(pos, Vector3.new(size, thickness, size))

    -- Efeito visual (partículas flutuantes azuis)
    local particle = Instance.new("ParticleEmitter")
    particle.Color = ColorSequence.new(Color3.fromRGB(0, 180, 255))
    particle.LightEmission = 1
    particle.Rate = 40
    particle.Size = NumberSequence.new(0.2)
    particle.Lifetime = NumberRange.new(0.5)
    particle.Speed = NumberRange.new(0.5)
    particle.Parent = root

    -- remove a jaula após um tempo
    task.delay(15, function()
        if jailFolder then jailFolder:Destroy() end
        if particle then particle:Destroy() end
    end)

    Notify("🔷 Jaula criada em volta de " .. target.Name)
end

-- Escuta o chat
LocalPlayer.Chatted:Connect(function(msg)
    local cmd, targetName = msg:match("^/(%w+)%s+(.+)")
    if cmd and cmd:lower() == "jail" then
        local target = FindPlayer(targetName)
        if target then
            CreateJail(target)
        else
            Notify("Jogador não encontrado: " .. targetName)
        end
    end
end)

Notify("🔹 Sistema /jail carregado! Use: /jail NomeDoJogador")