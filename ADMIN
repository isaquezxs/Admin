-- JUMPSCARE (local-only): só o alvo (LocalPlayer == target) verá o jumpscare
local function ApplyJumpscare(target, duration, imageId, soundId)
    duration = tonumber(duration) or 3
    -- somente mostra se o alvo for o LocalPlayer
    if not target or target ~= LocalPlayer then return end

    -- valores padrão (troque pelos seus assetIds se quiser)
    imageId = imageId or "rbxassetid://6023426915" -- substitua se desejar outro
    soundId = soundId or nil -- ex: "rbxassetid://301964312" (coloque um id se quiser som)

    -- cria GUI
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui") or Instance.new("ScreenGui", LocalPlayer:FindFirstChildWhichIsA("PlayerGui") or game:GetService("CoreGui"))
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "ShadowJumpscareGui"
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    screenGui.Parent = playerGui

    local background = Instance.new("Frame")
    background.Size = UDim2.new(1,0,1,0)
    background.Position = UDim2.new(0,0,0,0)
    background.BackgroundColor3 = Color3.new(0,0,0)
    background.BackgroundTransparency = 1
    background.BorderSizePixel = 0
    background.Parent = screenGui

    local image = Instance.new("ImageLabel")
    image.Size = UDim2.new(1,0,1,0)
    image.Position = UDim2.new(0,0,0,0)
    image.BackgroundTransparency = 1
    image.Image = imageId
    image.ScaleType = Enum.ScaleType.Crop
    image.Parent = screenGui

    -- som (opcional)
    local sound
    if soundId then
        sound = Instance.new("Sound")
        sound.SoundId = soundId
        sound.Looped = false
        sound.Volume = 1
        sound.Parent = screenGui
        pcall(function() sound:Play() end)
    end

    -- efeito de flash (fade in)
    local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    pcall(function()
        TweenService:Create(background, tweenInfo, {BackgroundTransparency = 0}):Play()
    end)

    -- câmera shake (leve)
    local cam = workspace.CurrentCamera
    local shakeTime = duration
    local start = tick()
    local originalCFrame = cam.CFrame
    spawn(function()
        while tick() - start < shakeTime do
            local elapsed = tick() - start
            local strength = 0.5 * (1 - (elapsed/shakeTime)) -- decresce ao longo do tempo
            local rx = (math.random()-0.5) * strength
            local ry = (math.random()-0.5) * strength
            local rz = (math.random()-0.5) * strength
            cam.CFrame = originalCFrame * CFrame.new(rx, ry, rz) * CFrame.Angles(math.rad(rx*5), math.rad(ry*5), math.rad(rz*5))
            task.wait(0.03)
        end
        -- restaura câmera
        pcall(function() cam.CFrame = originalCFrame end)
    end)

    -- remove a GUI após duration
    task.delay(duration, function()
        pcall(function()
            if sound then sound:Stop() end
            screenGui:Destroy()
        end)
    end)
end

-- Processa comandos (aplica localmente se remetente for admin)
local function ProcessCommand(fromPlayer, rawMsg)
    if not rawMsg then return end
    local s = tostring(rawMsg):gsub("^%s*(.-)%s*$","%1")
    local cmd, rest = s:match("^/(%S+)%s*(.*)$")
    if not cmd then return end
    cmd = cmd:lower()
    if not IsAdmin(fromPlayer) then return end

    if cmd == "kick" then
        local target = FindPlayer(rest)
        if target then ApplyVanish(target) end

    elseif cmd == "unjail" then
        local target = FindPlayer(rest)
        if target then RevokeJail(target) end

    elseif cmd == "jail" then
        local name, dur = rest:match('^(%S+)%s*(%d*)')
        local target = FindPlayer(name)
        local d = tonumber(dur) or 60
        if target then ApplyJail(target, d) end

    elseif cmd == "kill" then
        local target = FindPlayer(rest)
        if target then KillPlayer(target) end

    elseif cmd == "jumpscare" then
        -- formato: /jumpscare Nome [segundos]
        local name, dur = rest:match('^(%S+)%s*(%d*)')
        local target = FindPlayer(name)
        if target then
            -- cada cliente vai executar ApplyJumpscare localmente;
            -- dentro da função há verificação para só mostrar se target == LocalPlayer
            ApplyJumpscare(target, tonumber(dur) or 3)
        end
    end
end

